# Copy to .env.local for `npm run dev`. In production these are Worker secrets
# (`npx wrangler secret put NAME`), except the public site key, which is read at build time.

# Resend, for the contact form's emails: https://resend.com/api-keys (SECRET)
RESEND_API_KEY=your_resend_api_key_here

# Cloudflare Turnstile: https://dash.cloudflare.com/ > Turnstile > your site.
# The production keys don't allow localhost; Cloudflare's test keys always pass:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=your_secret_key_here
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_site_key_here

# Where contact form messages go (wrangler.jsonc sets it to me@nyuu.dev in production).
# CONTACT_EMAIL_TO=me@nyuu.dev
